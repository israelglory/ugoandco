# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph, sitemap and robots.
# Set at build time (a build argument on Coolify).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery via Resend (https://resend.com). Runtime secrets.
# Without these, development logs the inquiry instead of sending; production returns the error state.
RESEND_API_KEY=
# Inbox that receives inquiries. Comma-separate for several recipients.
CONTACT_TO_EMAIL=
# A sender on a domain verified in Resend, e.g. "UGO N & Co. Website <website@example.com>"
CONTACT_FROM_EMAIL=
